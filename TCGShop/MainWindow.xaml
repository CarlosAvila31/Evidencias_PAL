<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TCGShop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TCGShop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RED BULL Racing">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#0A1628" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tarjeta central -->
        <Border Grid.Row="1"
                Width="400"
                HorizontalAlignment="Center"
                CornerRadius="12"
                Background="#0F1E3A"
                BorderBrush="#E30118"
                BorderThickness="1">
            <StackPanel>

                <!-- Header -->
                <Border CornerRadius="12,12,0,0" Padding="32,28,32,22">
                    <Border.Background>
                        <SolidColorBrush Color="#1E3160" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Spacing="6">

                        <!-- Logo + nombre -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12">

                            <!-- LOGO -->
                            <Image Source="/Assets/logo-redbull.png"
                                   Width="200"
                                   Height="200"
                                   VerticalAlignment="Center" />

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ORACLE"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           CharacterSpacing="80" />
                                <TextBlock Text="RED BULL"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#E30118"
                                           CharacterSpacing="80" />
                                <TextBlock Text="RACING"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFC906"
                                           CharacterSpacing="120" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Línea decorativa -->
                        <Rectangle Height="2"
                                   Fill="#E30118"
                                   Margin="0,8,0,0"
                                   Opacity="0.8" />

                        <!-- Subtítulo -->
                        <TextBlock Text="ORACLE RED BULL RACING"
                                   FontSize="10"
                                   Foreground="#A8C4E0"
                                   HorizontalAlignment="Center"
                                   CharacterSpacing="100"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Cuerpo del formulario -->
                <StackPanel Padding="32,24,32,28" Spacing="14">

                    <TextBlock Text="Ingresa tus credenciales para continuar"
                               FontSize="13"
                               Foreground="#A8C4E0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <!-- Campo usuario -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="USUARIO"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFC906"
                                   CharacterSpacing="80" />
                        <TextBox x:Name="UsernameTextBox"
                                 PlaceholderText="nombre de usuario"
                                 Foreground="White"
                                 Background="#162040"
                                 BorderBrush="#E30118"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 Padding="12,9" />
                    </StackPanel>

                    <!-- Campo contraseña -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="CONTRASEÑA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFC906"
                                   CharacterSpacing="80" />
                        <PasswordBox x:Name="PasswordBox"
                                     PlaceholderText="••••••••"
                                     Foreground="White"
                                     Background="#162040"
                                     BorderBrush="#E30118"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                     Padding="12,9" />
                    </StackPanel>

                    <!-- Mensaje de estado -->
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"
                               FontSize="12"
                               HorizontalAlignment="Center" />

                    <!-- Botones -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="CreateUserButton"
                                Content="Registrarse"
                                HorizontalAlignment="Stretch"
                                Click="CreateUser_Click"
                                Background="Transparent"
                                BorderBrush="#FFC906"
                                BorderThickness="1"
                                Foreground="#FFC906"
                                CornerRadius="6"
                                Padding="0,10" />

                        <Button Grid.Column="2"
                                x:Name="LoginButton"
                                Content="Iniciar sesión"
                                HorizontalAlignment="Stretch"
                                Click="Login_Click"
                                Background="#E30118"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="0,10" />
                    </Grid>
                </StackPanel>

                <!-- Franja decorativa roja -->
                <Rectangle Height="3" Fill="#E30118" />

                <!-- Footer -->
                <Border Padding="0,10"
                        CornerRadius="0,0,12,12"
                        Background="#0F1E3A">
                    <TextBlock Text="© 2025 Red Bull Racing · Todos los derechos reservados"
                               FontSize="11"
                               Foreground="#4A6080"
                               HorizontalAlignment="Center" />
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>